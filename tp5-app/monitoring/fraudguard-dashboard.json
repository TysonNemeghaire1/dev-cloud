{
  "uid": "fraudguard-overview",
  "title": "FraudGuard — Détection de fraude temps réel",
  "tags": ["fraud", "kafka", "fraudguard"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Panel 1 — Débit de transactions (msg/s) [transactions-raw]",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "mps",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "red", "value": 300 }
          ] }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(kafka_server_brokertopicmetrics_messagesin_total{topic=\"transactions-raw\"}[1m]))",
          "legendFormat": "transactions-raw msg/s"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Panel 2 — Alertes de fraude générées (par min) [fraud-alerts]",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "orange", "value": 5 },
            { "color": "red", "value": 10 }
          ] }
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(kafka_server_brokertopicmetrics_messagesin_total{topic=\"fraud-alerts\"}[5m])) * 60",
          "legendFormat": "alertes/min"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Panel 3 — Consumer Lag du Fraud Detector [fraud-detection-group]",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "red", "value": 1000 }
          ] }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(kafka_consumergroup_lag{consumergroup=\"fraud-detection-group\"})",
          "legendFormat": "lag total"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Panel 4 — Latence de détection P99 (Producer → Alert) [ms]",
      "description": "Histogramme fraud_detection_latency_seconds exposé par le fraud-detector (prom-client). Objectif FraudGuard : < 500 ms en P99.",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "red", "value": 500 }
          ] }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.99, sum(rate(fraud_detection_latency_seconds_bucket[5m])) by (le)) * 1000",
          "legendFormat": "P99 (ms)"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.50, sum(rate(fraud_detection_latency_seconds_bucket[5m])) by (le)) * 1000",
          "legendFormat": "P50 (ms)"
        }
      ]
    }
  ]
}
